10 CLS:DIM V(6,6),P(6,6),M(6,6):REM value, player, max
15 C$(0)=CHR$(27)+"q":C$(1)=C$(0):C$(2)=CHR$(27)+"p":PRINT"Setting up..."
20 FORR=0TO6:FORC=0TO6:IF(R=0)OR(C=0)OR(R=6)OR(C=6)THENM(R,C)=3ELSEM(R,C)=4
25 NEXT:NEXT:M(0,0)=2:M(0,6)=2:M(6,0)=2:M(6,6)=2
30 DIM QX(99),QY(99):N=0: REM queue
40 X=0:Y=0:T=1:CLS:GOSUB1000:GOSUB500
99 REM main loop:
100 PRINT@(X*2+1+Y*80+40),C$(P(Y,X))"*"
110 A$=INKEY$:XX=X:YY=Y:GOSUB2000
200 IFA$="j"THENY=(Y+1)MOD7
210 IFA$="k"THENY=(Y+6)MOD7
220 IFA$="h"THENX=(X+6)MOD7
230 IFA$="l"THENX=(X+1)MOD7
240 IFA$=CHR$(13)THENGOSUB300
250 GOTO100
290 REM place a pellet
300 IFP(Y,X)=3-T THEN BEEP:RETURN:REM bad
310 IFP(Y,X)=0THENS(T)=S(T)+1:P(Y,X)=T
320 V(Y,X)=V(Y,X)+1:XX=X:YY=Y:GOSUB2000
330 REM if past critical, explode
340 IF V(Y,X)<M(Y,X)THEN490
350 S(T)=S(T)-1:P(Y,X)=0:V(Y,X)=0:REM decrease score, clear ownership & value
360 N=0:REM seed queue:
370 GOSUB5000:GOSUB2000 : REM draw cleared avlue
390 NN=0
399 REM process queue
400 IF NN=N THEN 490
410 XX=QX(NN):YY=QY(NN)
415 IF P(YY,XX)<>T THEN S(T)=S(T)+1:REM rease our score
420 IF P(YY,XX)=3-T THEN S(3-T)=S(3-T)-1:REM decrease opponent score
425 P(YY,XX)=T:V(YY,XX)=V(YY,XX)+1
430 GOSUB2000:REM draw new value
440 IFV(YY,XX)>=M(YY,XX)THENV(YY,XX)=0:P(YY,XX)=0:S(T)=S(T)-1:GOSUB5000:GOSUB2000: REM add to queue
480 NN=NN+1:GOTO400
490 T=3-T:REM fall through to draw scores,then return
499 REM draw scores
500 PRINT@0,C$(1):IFT=1THENPRINT@25,"*"ELSEPRINT@25," "
510 PRINT@26,"White:"S(1)
515 PRINT@0,C$(2):IFT=2THENPRINT@65,"*"ELSEPRINT@65," "
520 PRINT@66,"Black:"S(2)
530 PRINT@0,C$(0):RETURN
999 REM draw empty board:
1000 FORR=1TO7:GOSUB1100
1010 PRINT"|";:FORC=1TO7:PRINT" |";:NEXT:PRINT:NEXT
1020 GOSUB1100:RETURN
1099 REM draw a long line
1100 FORI=1TO7:PRINT"+-";:NEXT:PRINT"+":RETURN
1999 REM draw value at xx,yy
2000 C=32:IFP(YY,XX)>0THENC=48+V(YY,XX)
2010 PRINT@(XX*2+1+YY*80+40),C$(P(YY,XX))CHR$(C)C$(0)
2100 RETURN
4999 REM Enqueue the entry at xx,yy
5000 IFXX>0THENQX(N)=XX-1:QY(N)=YY:N=N+1
5010 IFXX<6THENQX(N)=XX+1:QY(N)=YY:N=N+1
5020 IFYY>0THENQX(N)=XX:QY(N)=YY-1:N=N+1
5030 IFYY<6THENQX(N)=XX:QY(N)=YY+1:N=N+1
5040 REMFORI=0TON-1:PRINT@((IMOD16)*40+25),I;QX(I);QY(I):NEXT
5100 RETURN

5 CLS:?CHR$(27)"U";:INPUT "DIFFICULTY (1=EASY, 2=MED, 3=HARD)";LV:IFLV<1ORLV>3THEN5
10 DIMV(6,6),P(6,6),M(6,6):REM value, player, max
20 DIMQX(199),QY(199):N=0:REM queue
30 C$(0)=CHR$(27)+"q":C$(1)=C$(0):C$(2)=CHR$(27)+"p":REM color per player
35 SC=1-(PEEK(1)=171):REM scale (i.e., Tandy 200=2, everything else=1)
40 PRINT"Setting up...":FORR=0TO6:FORC=0TO6:M(R,C)=4+((R=0)OR(R=6))+((C=0)OR(C=6)):NEXT:NEXT
50 X=0:Y=0:T=1:CLS:GOSUB1000:GOSUB500:REM draw board, scors
100 IFT=2THENGOSUB6000:X=CX:Y=CY:GOSUB300: REM pick computer spot, update value
110 XX=X:YY=Y:V$="*":GOSUB4000
120 A$=INKEY$:XX=X:YY=Y:GOSUB 2000: REM draw at location
200 IFA$="j"THENY=(Y+1)MOD7
210 IFA$="k"THENY=(Y+6)MOD7
220 IFA$="h"THENX=(X+6)MOD7
230 IFA$="l"THENX=(X+1)MOD7
240 IFA$=CHR$(13)THENGOSUB300
290 GOTO100
299 REM process attempt to drop pellet
300 IFP(Y,X)=3-T THEN BEEP:RETURN: REM no available
310 IFP(Y,X)=0THEN S(T)=S(T)+1:P(Y,X)=T
320 V(Y,X)=V(Y,X)+1:XX=X:YY=Y:GOSUB2000
340 IFV(Y,X)<M(Y,X)THEN490:REM boom
350 S(T)=S(T)-1:P(Y,X)=0:V(Y,X)=0
359 REM seed queue
360 N=0:GOSUB 5000:GOSUB 2000:NN=0
399 REM process queue
400 IF NN=N THEN490
410 XX=QX(NN):YY=QY(NN)
415 IF P(YY,XX)<>T THENS(T)=S(T)+1:REM we captured one
420 IF P(YY,XX)=3-T THENS(3-T)=S(3-T)-1:REM they lost one
425 P(YY,XX)=T:V(YY,XX)=V(YY,XX)+1
430 GOSUB2000
440 IFV(YY,XX)>=M(YY,XX)THEN V(YY,XX)=0:P(YY,XX)=0:S(T)=S(T)-1:GOSUB5000:GOSUB2000
480 NN=NN+1:GOTO400
490 T=3-T:GOSUB500:GOSUB550:RETURN: rem switch players
499 REM print scores:
500 LOCATE25,0:PRINTC$(1);:IF T=1 THEN PRINT"*";ELSE PRINT" ";
510 PRINT"White:"S(1)
515 LOCATE25,1:PRINTC$(2);:IF T=2 THEN PRINT"*";ELSE PRINT" ";
520 PRINT"Black:"S(2)c$(0)
530 RETURN
549 REM Test for Win
550 LOCATE25,2
560 IF S(1)>0 AND S(2)=0AND(S(1)+S(2))>1 THEN PRINT"HUMAN WINS!":END
570 IF S(2)>0 AND S(1)=0AND(S(1)+S(2))>1 THEN PRINT"COMPUTER WINS!":END
580 RETURN
999 REM print the empty board
1000 IF SC=1 THEN1050
1010 FORR=1TO7:GOSUB 1100:PRINT"| | | | | | | |":NEXT
1020 GOSUB 1100:RETURN
1050 FORR=1TO7:PRINT"|.......|":NEXT:RETURN
1099 REM print a long line
1100 PRINT"+-+-+-+-+-+-+-+":RETURN
1999 REM print value at its spot xx,yy
2000 C=32-14*(SC=1):IFP(YY,XX)>0THENC=48+V(YY,XX)
2010 V$=C$(P(YY,XX))+CHR$(C)+C$(0):GOSUB4000:RETURN
3999 REM print v$ at xx, yy scaled by sc
4000 LOCATE XX*SC+1,YY*SC+(SC-1):?V$;
4100 RETURN
4999 REM enqueue xx,yy
5000 IF XX>0 THEN QX(N)=XX-1:QY(N)=YY:N=N+1
5010 IF XX<6 THEN QX(N)=XX+1:QY(N)=YY:N=N+1
5020 IF YY>0 THEN QX(N)=XX:QY(N)=YY-1:N=N+1
5030 IF YY<6 THEN QX(N)=XX:QY(N)=YY+1:N=N+1
5100 RETURN
6000 REM *** AI SUBROUTINE
6010 IF S(1)+S(2)=49 THENRETURN:REM SAFETY FOR FULL BOARD
6020 IF LV>1 THEN6050
6030 CX=INT(7*RND(1)):CY=INT(7*RND(1))
6040 IF P(CY,CX)=1 THEN6020:REM RE-ROLL IF OWNED BY HUMAN
6045 RETURN
6050 MS=-999:CX=0:CY=0:FORI=0TO6:FORJ=0TO6
6060 IF P(I,J)=1THEN6130
6069 REM Pick near the edge and even bette if it's almost critical
6070 S=(4-M(I,J))*10+V(I,J)*2:IF V(I,J)+1>=M(I,J)THENS=S+50
6080 IF LV<3 THEN 6120
6089 REM Don't place next to human if it is almost critical
6090 IF J>0 THENIF P(I,J-1)=1 AND V(I,J-1)=M(I,J-1)-1 THEN S=S-60
6100 IF J<6 THENIF P(I,J+1)=1 AND V(I,J+1)=M(I,J+1)-1 THEN S=S-60
6110 IF I>0 THENIF P(I-1,J)=1 AND V(I-1,J)=M(I-1,J)-1 THEN S=S-60
6115 IF I<6 THENIF P(I+1,J)=1 AND V(I+1,J)=M(I+1,J)-1 THEN S=S-60
6119 REM pick best value
6120 IF S>MS THEN MS=S:CX=J:CY=I
6130 NEXT:NEXT:RETURN

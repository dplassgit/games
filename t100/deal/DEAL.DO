10 REM DEAL/NO DEAL FOR TANDY 100 BY DAVID PLASS BASED ON:
15 REM DEAL/NO DEAL FOR AMSTRAD NC-200 BY ALVIN BANDERAS(C)17/2/26
20 CLS:CLEAR:?CHR$(27)"V": REM prevent scrolling
25 R=RND(-PEEK(63791)): REM seed random numbers with time
30 DIM V(22),O(22),A(22),A$(22): REM Randomized box value, open flag, sorted box value, box value as string
40 GOSUB 340: REM INIT
50 R=1: REM round #
60 U=5: REM # boxes to open this round
70 W=0: REM # boxes opened this round so far
80 D=0: REM deal made flag
90 RV$=CHR$(27)+"p":NV$=CHR$(27)+"q": REM reverse video, normal video
100 REM MAIN GAME LOOP
110 GOSUB 580: REM SHOW BOARD AND TEXT
120 PRINT @280,RV$;" CHOOSE BOX TO OPEN :";NV$;:INPUT B$
130 PRINT @280,SPACE$(39);
140 B=VAL(B$)
150 IF B<1 OR B>22 THEN PRINT @280,"INVALID!":GOSUB2000:GOTO 120
160 IF O(B)=1 THEN PRINT @280,"ALREADY OPEN!":GOSUB2000:GOTO 120
170 IF B=P THEN PRINT @280,"THAT'S YOUR BOX!":GOSUB2000:GOTO 120
180 GOSUB 800: REM OPEN BOX
190 W=W+1
200 IF W<U THEN 110
210 REM END OF ROUND - BANKER OFFER
220 GOSUB 880: REM BANKER OFFER
230 CLS:PRINT RV$;" >> BANKER'S OFFER << $";F
240 PRINT " DEAL (D)  OR  NO DEAL (N) ??? ";NV$;
250 K$=INKEY$:IF K$="" THEN 250
260 IF K$="D" OR K$="d" THEN D=1:GOTO 960
270 IF K$<>"N" AND K$<>"n" THEN 240
280 PRINT @240,RV$;"  N O   D E A L  !";NV$
290 IF R=6 THEN 1030: REM FINAL ROUND
300 R=R+1:U=3:W=0
310 GOSUB 2000: REM delay
320 GOTO 110
330 REM END MAIN LOOP
340 REM INITIALISATION
360 FOR I=1 TO 22: O(I)=0: READ A$(I): NEXT 
380 RESTORE
390 FOR I=1 TO 22:READ V(I): A(I)=V(I): NEXT 
400 DATA 1,10,50,100,250,500,750,1000,2000,3000
410 DATA 5000,7500,10000,15000,20000,30000,50000
420 DATA 75000,100000,150000,200000,250000
430 REM RANDOMISE V()
440 FOR I=1 TO 22
450   X=INT(RND(1)*22)+1
460   T=V(I):V(I)=V(X):V(X)=T
470 NEXT
480 CLS
490 PRINT "PICK YOUR BOX (1-22):";
500 INPUT P$:P=VAL(P$)
520 IF P<1 OR P>22 THEN 480
540 C=22: REM total boxes left
550 PRINT "YOU HAVE BOX #";P
555 GOSUB 2000: REM delay
560 RETURN
580 REM SHOW BOARD
590 CLS
600 REM HEADER
610 PRINT RV$;" ROUND ";R;"  OPEN";U;
620 IF U>1 THEN PRINT "BOXES" ELSE PRINT "BOX"
630 PRINT " YOUR BOX: #";P;"  BOXES LEFT";C-1;NV$
640 REM DISPLAY AMOUNTS 
650 RR=2:CC=0: REM row, column
660 FOR I=1 TO 22: PRINT @RR*40+CC*8,"";
670   IF A(I)<>0 THEN PRINT "$"A$(I); ELSE PRINT SPACE$(7);
675 CC=CC+1: IF ((I-1)MOD5)=4 THEN RR=RR+1:CC=0
680 NEXT
790 RETURN
800 REM OPEN A BOX 
820 PRINT @280,RV$;"BOX #";B;" CONTAINS: $";V(B);NV$;
825 REM Look through all the boxes to find V(B)'s dollar amount, and erase that one.
830 FOR I=1 TO 22:IF A(I)=V(B) THEN A(I)=0
835 NEXT
840 O(B)=1: C=C-1
850 GOSUB 2000: REM delay
860 RETURN
870 REM
880 REM BANKER'S OFFER (80% OF AVERAGE)
890 S=0:N=0
900 FOR I=1 TO 22
910   IF O(I)=0 THEN S=S+V(I):N=N+1
920 NEXT 
930 F=INT((S/N)*0.8)
940 RETURN
950 REM
960 REM PLAYER TOOK THE DEAL
970 PRINT: PRINT "YOU TOOK THE DEAL! BANKER PAYS: $";F;" YOUR BOX #";P;" HAD: $";V(P)
980 PRINT: PRINT " >> PLAY AGAIN (Y/N) ? <<";
990 K$=INKEY$:IF K$="" THEN 990
1000 IF K$="Y" OR K$="y" THEN RUN
1010 END
1020 REM
1030 REM FINAL ROUND (TWO BOXES LEFT)
1040 CLS
1050 PRINT "FINAL TWO BOXES:"
1060 PRINT "YOUR BOX #";P
1070 FOR I=1 TO 22
1080   IF O(I)=0 AND I<>P THEN Y=I
1090 NEXT
1100 PRINT "OTHER BOX #";Y
1110 PRINT "BANKER OFFERS SWAP. "
1120 PRINT "SWAP (S) OR KEEP (K)?";
1130 K$=INKEY$:IF K$="" THEN 1130
1140 IF K$="S" OR K$="s" THEN T=P:P=Y:Y=T:PRINT "YOU SWAPPED!"
1150 IF K$="K" OR K$="k" THEN PRINT "YOU KEPT YOUR BOX."
1160 IF K$<>"S" AND K$<>"s" AND K$<>"K" AND K$<>"k" THEN 1120
1170 PRINT "YOUR BOX CONTAINS: $";V(P)
1180 PRINT "PLAY AGAIN (Y/N)?";
1190 K$=INKEY$:IF K$="" THEN 1190
1200 IF K$="Y" OR K$="y" THEN RUN
1210 END
2000 FOR T=1 TO 1000:NEXT:RETURN
